#pragma kernel CSMain

float _Spacing;
float _DrawDistance;
float _TextureUpdateThreshold;
float _FullDensityDistance;
float _LODDistance;

float _PatchScale;
float _PatchStrength;
float _FarDensityMultiplier;
float _DensityMultiplier;

float _EdgeNoiseScale;
float _EdgeNoiseStrength;

int _LayerSeed;

int2 _GridStartIndex;
int2 _GridSize;

float3 _CameraPosition;
float2 _CenterPos;
float3 _BoundsMin;
float3 _BoundsMax;

float4x4 _VPMatrix;

int _UseTerrainLayerMask;
int _TerrainLayerChannel;
float _TerrainLayerThreshold;

float3 _TerrainPosition;
float3 _TerrainSize;

int _UseSlopeFilter;
float _MaxSlope;
float _SlopeFade;
float _HeightMapSize;

SamplerState linearClampSampler;

Texture2D<float2> _GrassHeightMapRT;
Texture2D<float> _GrassMaskMapRT;
Texture2D<float4> _TerrainControl;

AppendStructuredBuffer<float3> _GrassPositionsNear;
AppendStructuredBuffer<float3> _GrassPositionsFar;

uint murmurHash3(int input)
{
    uint h = abs(input);
    h ^= h >> 16;
    h *= 0x85ebca6b;
    h ^= h >> 13;
    h *= 0xc2b2ae3d;
    h ^= h >> 16;
    return h;
}

float random(int input)
{
    return murmurHash3(input) / 4294967295.0;
}

float Remap(float value, float2 inputRange, float2 outputRange)
{
    return outputRange.x + (value - inputRange.x) * (outputRange.y - outputRange.x) / (inputRange.y - inputRange.x);
}

float ValueNoise(float2 p)
{
    int2 cell = (int2)floor(p);
    float2 f = frac(p);
    f = f * f * (3.0 - 2.0 * f);

    int seed = _LayerSeed * 92821;

    float a = random(cell.x * 73856093 + cell.y * 19349663 + seed);
    float b = random((cell.x + 1) * 73856093 + cell.y * 19349663 + seed);
    float c = random(cell.x * 73856093 + (cell.y + 1) * 19349663 + seed);
    float d = random((cell.x + 1) * 73856093 + (cell.y + 1) * 19349663 + seed);

    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float GetPatchDensity(float2 positionXZ)
{
    float noise1 = ValueNoise(positionXZ * _PatchScale);
    float noise2 = ValueNoise(positionXZ * (_PatchScale * 2.13) + float2(17.4, -31.7));

    float patchNoise = saturate(noise1 * 0.72 + noise2 * 0.28);
    patchNoise = smoothstep(0.25, 0.75, patchNoise);

    return lerp(1.0 - _PatchStrength, 1.0, patchNoise);
}

float GetDistanceDensity(float distanceFromCamera, float2 positionXZ)
{
    if (distanceFromCamera <= _FullDensityDistance) return 1.0;

    float edgeNoise = ValueNoise(positionXZ * _EdgeNoiseScale + float2(61.7, 19.3));
    edgeNoise = edgeNoise * 2.0 - 1.0;

    float localDrawDistance = _DrawDistance + edgeNoise * _EdgeNoiseStrength;
    localDrawDistance = max(localDrawDistance, _FullDensityDistance + 1.0);

    return 1.0 - smoothstep(_FullDensityDistance, localDrawDistance, distanceFromCamera);
}

float GetTerrainLayerWeight(float2 positionXZ)
{
    if (_UseTerrainLayerMask == 0) return 1.0;

    float2 terrainUV = (positionXZ - _TerrainPosition.xz) / _TerrainSize.xz;
    if (any(terrainUV < 0.0) || any(terrainUV > 1.0)) return 0.0;

    float4 control = _TerrainControl.SampleLevel(linearClampSampler, terrainUV, 0);

    float weight = control.r;
    if (_TerrainLayerChannel == 1) weight = control.g;
    else if (_TerrainLayerChannel == 2) weight = control.b;
    else if (_TerrainLayerChannel == 3) weight = control.a;

    return smoothstep(_TerrainLayerThreshold, min(_TerrainLayerThreshold + 0.25, 1.0), weight);
}

float SampleWorldHeight(float2 uv)
{
    float encodedHeight = _GrassHeightMapRT.SampleLevel(linearClampSampler, uv, 0).r;
    return Remap(encodedHeight, float2(0,1), float2(_BoundsMin.y,_BoundsMax.y));
}

float GetSlopeDensity(float2 uv)
{
    if (_UseSlopeFilter == 0) return 1.0;

    float texel = 1.0 / max(_HeightMapSize, 1.0);

    float hL = SampleWorldHeight(uv + float2(-texel,0));
    float hR = SampleWorldHeight(uv + float2(texel,0));
    float hD = SampleWorldHeight(uv + float2(0,-texel));
    float hU = SampleWorldHeight(uv + float2(0,texel));

    float worldStep = ((_DrawDistance + _TextureUpdateThreshold) * 2.0) / max(_HeightMapSize,1.0);

    float dhdx = (hR - hL) / max(worldStep * 2.0,0.0001);
    float dhdz = (hU - hD) / max(worldStep * 2.0,0.0001);

    float3 terrainNormal = normalize(float3(-dhdx,1.0,-dhdz));
    float slope = degrees(acos(saturate(terrainNormal.y)));

    return 1.0 - smoothstep(max(_MaxSlope - _SlopeFade,0.0),_MaxSlope,slope);
}

[numthreads(8,8,1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    int2 dispatchID = int2(id.xy);
    if (dispatchID.x >= _GridSize.x || dispatchID.y >= _GridSize.y) return;

    int2 currentIndex = _GridStartIndex + dispatchID;
    int seed = _LayerSeed * 92821;

    float2 positionXZ = currentIndex * _Spacing;

    float2 randomOffset = float2(
        random(currentIndex.x * 5542 + currentIndex.y * 17 + seed),
        random(currentIndex.y * 9824 + currentIndex.x * 31 + seed)
    );

    positionXZ += (randomOffset * 2.0 - 1.0) * _Spacing * 0.45;

    float2 uv = (positionXZ - _CenterPos) / (_TextureUpdateThreshold + _DrawDistance);
    uv = uv * 0.5 + 0.5;

    if (any(uv < 0.0) || any(uv > 1.0)) return;

    float2 heightMap = _GrassHeightMapRT.SampleLevel(linearClampSampler,uv,0).rg;
    if (heightMap.g <= 0.5) return;

    float maskValue = _GrassMaskMapRT.SampleLevel(linearClampSampler,uv,0).r;
    if (random(currentIndex.x * 9421 + currentIndex.y * 3571 + seed) < saturate(maskValue)) return;

    float positionY = Remap(heightMap.r,float2(0,1),float2(_BoundsMin.y,_BoundsMax.y));
    float3 positionWS = float3(positionXZ.x,positionY,positionXZ.y);

    float distanceFromCamera = length(_CameraPosition - positionWS);

    float distanceDensity = GetDistanceDensity(distanceFromCamera,positionXZ);
    if (distanceDensity <= 0.001) return;

    float patchDensity = GetPatchDensity(positionXZ);
    float terrainDensity = GetTerrainLayerWeight(positionXZ);
    float slopeDensity = GetSlopeDensity(uv);

    float finalDensity = distanceDensity * patchDensity * terrainDensity * slopeDensity * _DensityMultiplier;

    bool isFar = distanceFromCamera >= _LODDistance;
    if (isFar) finalDensity *= _FarDensityMultiplier;

    if (random(currentIndex.x * 1237 + currentIndex.y * 5683 + seed) >= finalDensity) return;

    float4 positionCS = mul(_VPMatrix,float4(positionWS,1.0));
    float4 absPosCS = abs(positionCS);

    bool insideFrustum = positionCS.w > 0.0 && absPosCS.x <= absPosCS.w * 1.10 && absPosCS.y <= absPosCS.w * 1.35 && absPosCS.z <= absPosCS.w;
    if (!insideFrustum) return;

    if (isFar) _GrassPositionsFar.Append(positionWS);
    else _GrassPositionsNear.Append(positionWS);
}